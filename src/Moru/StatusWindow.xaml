<Window x:Class="Moru.StatusWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Moru"
        Title="모루 · 내 PC 상태" Width="364" Height="700" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="True" UseLayoutRounding="True"
        PreviewKeyDown="OnKeyDown">
  <Border Background="#FCFDFB" BorderBrush="#D7E2DA" BorderThickness="1" CornerRadius="22" Padding="23,19,23,17">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <Grid>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="M O R U" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Accent}" />
            <TextBlock Text="내 PC, 한눈에" FontSize="23" FontWeight="SemiBold" Margin="0,5,0,0" />
          </StackPanel>
          <Button Content="×" Width="34" Height="34" FontSize="22" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Top"
                  Background="Transparent" ToolTip="패널 닫기 · 측정 일시 정지" AutomationProperties.Name="패널 닫기" Click="OnHide" />
        </Grid>
        <TextBlock Text="지금 컴퓨터가 얼마나 바쁜지 살펴봐요." FontSize="11" Foreground="{StaticResource Muted}" Margin="0,9,0,18" />

        <Border Background="{DynamicResource Soft}" CornerRadius="15" Padding="17,13,17,14">
          <StackPanel>
            <Grid><TextBlock Text="CPU" FontSize="12" FontWeight="SemiBold" /><TextBlock x:Name="CpuStatus" Text="측정 준비 중" FontSize="10" Foreground="{DynamicResource Accent}" HorizontalAlignment="Right" /></Grid>
            <TextBlock x:Name="CpuValue" Text="—" FontSize="34" FontWeight="SemiBold" Margin="0,4,0,7" />
            <ProgressBar x:Name="CpuBar" AutomationProperties.Name="CPU 사용률 막대" />
            <TextBlock x:Name="CpuDetail" Text="첫 측정값을 기다리고 있어요" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,8,0,0" />
          </StackPanel>
        </Border>

        <Border Background="#F1F3F0" CornerRadius="15" Padding="17,13,17,14" Margin="0,10,0,0">
          <StackPanel>
            <Grid><TextBlock Text="메모리" FontSize="12" FontWeight="SemiBold" /><TextBlock Text="RAM" FontSize="10" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" /></Grid>
            <TextBlock x:Name="MemoryValue" Text="—" FontSize="34" FontWeight="SemiBold" Margin="0,4,0,7" />
            <ProgressBar x:Name="MemoryBar" AutomationProperties.Name="메모리 사용률 막대" />
            <TextBlock x:Name="MemoryDetail" Text="사용 중 / 전체 메모리" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,8,0,0" />
          </StackPanel>
        </Border>

        <Grid Margin="0,19,0,9"><TextBlock Text="함께할 친구" FontSize="12" FontWeight="SemiBold" /><TextBlock Text="누르면 바로 바뀌어요" FontSize="10" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" /></Grid>
        <ScrollViewer x:Name="SkinScroll" MaxHeight="180" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl x:Name="SkinList">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate><DataTemplate>
              <RadioButton GroupName="Skins" Tag="{Binding}" Checked="OnSkinSelected" Margin="0,0,6,5"
                           AutomationProperties.Name="{Binding Name}" Cursor="Hand" ToolTip="{Binding Description}">
                <RadioButton.Template><ControlTemplate TargetType="RadioButton">
                  <Border x:Name="Card" Background="White" BorderBrush="#E1E7E1" BorderThickness="1" CornerRadius="12" Padding="0,3,0,8">
                    <StackPanel><local:PetView Skin="{Binding}" Height="55" Width="62" />
                      <TextBlock Text="{Binding Name}" HorizontalAlignment="Center" FontSize="11" />
                    </StackPanel>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Card" Property="Background" Value="{DynamicResource Soft}" /><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Accent}" /></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Accent}" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Card" Property="BorderThickness" Value="2" /></Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate></RadioButton.Template>
              </RadioButton>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <Grid Margin="0,5,0,0">
          <Button Content="+ PNG 친구 추가" Click="OnImportSkin" HorizontalAlignment="Left" Padding="10,6" FontSize="11"
                  ToolTip="투명 배경 PNG를 선택하면 바로 적용돼요. 2048px·8 MiB 이하" />
          <Button Content="소개 화면 저장" Click="OnExportPreview" HorizontalAlignment="Right" Padding="10,6" FontSize="11"
                  ToolTip="다른 프로그램이나 바탕화면을 담지 않고, 모루의 현재 화면을 PNG로 저장해요." />
        </Grid>

        <Button x:Name="AiButton" Content="AI 작업 · Codex / Claude Code" Click="OnAi" Margin="0,12,0,0" FontSize="11" />
        <CheckBox x:Name="AnimationToggle" Content="캐릭터 애니메이션" FontSize="11" Margin="0,12,0,0" Checked="OnAnimation" Unchecked="OnAnimation" />
        <Grid Margin="0,13,0,0">
          <CheckBox x:Name="TopmostToggle" Content="항상 위에" FontFamily="Malgun Gothic" FontSize="11" VerticalAlignment="Center"
                    Checked="OnTopmostChanged" Unchecked="OnTopmostChanged" ToolTip="다른 창 위에도 캐릭터를 표시합니다" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <TextBlock Text="갱신 간격" FontSize="10" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox x:Name="RefreshPicker" Width="60" Height="26" FontSize="11" SelectionChanged="OnIntervalChanged" AutomationProperties.Name="갱신 간격">
              <ComboBoxItem Content="2초" Tag="2" /><ComboBoxItem Content="5초" Tag="5" /><ComboBoxItem Content="10초" Tag="10" />
            </ComboBox>
          </StackPanel>
        </Grid>
        <Border Height="1" Background="#E5EAE4" Margin="0,16,0,12" />
        <Grid>
          <StackPanel>
            <TextBlock x:Name="FooterStatus" Text="패널을 닫으면 측정도 쉬어요." FontSize="10" Foreground="{StaticResource Muted}" MaxWidth="245" TextWrapping="Wrap" HorizontalAlignment="Left" />
            <TextBlock Text="클릭해서 확인 · 드래그해서 이동" FontSize="9" Foreground="#839087" Margin="0,4,0,0" />
          </StackPanel>
          <Button Content="종료" Click="OnExit" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="9,5" FontSize="10" ToolTip="모루 완전히 종료" />
        </Grid>
      </StackPanel>
    </ScrollViewer>
  </Border>
</Window>
