<Window Foreground="{DynamicResource Ink}" x:Class="Moru.StatusWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="모루 · 대시보드" Width="440" Height="720" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="True" UseLayoutRounding="True" PreviewKeyDown="OnKeyDown">
 <Border Background="{DynamicResource Canvas}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="22" Padding="22">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
 <StackPanel>
  <Grid Margin="0,0,0,18"><TextBlock Text="내 PC" FontSize="{DynamicResource TitleSize}" FontWeight="SemiBold" VerticalAlignment="Center"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
    <Button Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="설정" AutomationProperties.Name="설정 열기" Click="OnSettings"/>
    <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" ToolTip="닫기" AutomationProperties.Name="대시보드 닫기" Click="OnHide"/>
   </StackPanel>
  </Grid>
  <Grid Margin="0,0,0,18">
   <StackPanel><TextBlock x:Name="ClockText" FontSize="{DynamicResource ClockSize}" FontWeight="SemiBold"/><TextBlock x:Name="DateText" Style="{StaticResource Caption}" Margin="0,2,0,0"/></StackPanel>
   <Button x:Name="AlarmButton" Content="알람 추가" HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnAlarms" ToolTip="알람 설정" MaxWidth="175"/>
  </Grid>
  <UniformGrid Columns="2">
   <Border Style="{StaticResource Card}" Background="{DynamicResource Soft}" Margin="0,0,6,0">
    <StackPanel><TextBlock Text="CPU" FontWeight="SemiBold"/><TextBlock x:Name="CpuValue" Text="—" FontSize="{DynamicResource MetricSize}" FontWeight="SemiBold" Margin="0,7,0,10"/><ProgressBar x:Name="CpuBar" AutomationProperties.Name="CPU 사용률"/><TextBlock x:Name="CpuDetail" Text="측정 준비 중" Style="{StaticResource Caption}" Margin="0,10,0,0"/></StackPanel>
   </Border>
   <Border Style="{StaticResource Card}" Margin="6,0,0,0">
    <StackPanel><TextBlock Text="메모리" FontWeight="SemiBold"/><TextBlock x:Name="MemoryValue" Text="—" FontSize="{DynamicResource MetricSize}" FontWeight="SemiBold" Margin="0,7,0,10"/><ProgressBar x:Name="MemoryBar" AutomationProperties.Name="메모리 사용률"/><TextBlock x:Name="MemoryDetail" Style="{StaticResource Caption}" Margin="0,10,0,0"/></StackPanel>
   </Border>
  </UniformGrid>
  <Border Style="{StaticResource Card}" Margin="0,14,0,0">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="AI 작업" FontWeight="SemiBold"/><TextBlock x:Name="AiSummary" Style="{StaticResource Caption}" Margin="0,7,8,0"/></StackPanel>
    <Button Grid.Column="1" Content="보기" Click="OnAi" VerticalAlignment="Center" AutomationProperties.Name="AI 작업 보기"/>
   </Grid>
  </Border>
  <Border Style="{StaticResource Card}" Margin="0,14,0,0">
   <StackPanel>
    <Grid><TextBlock Text="소리" FontWeight="SemiBold"/><TextBlock x:Name="VolumeLabel" Text="—" HorizontalAlignment="Right" Foreground="{DynamicResource Accent}"/></Grid>
    <ComboBox x:Name="AudioPicker" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="OnAudioTarget" Margin="0,12,0,8" AutomationProperties.Name="볼륨 조절 대상"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Button x:Name="MuteButton" Style="{StaticResource IconButton}" Content="&#xE767;" Click="OnMute" AutomationProperties.Name="음소거 전환" ToolTip="음소거"/>
     <Slider x:Name="VolumeSlider" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="1" SmallChange="1" LargeChange="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="8,0,0,0" ValueChanged="OnVolume" AutomationProperties.Name="볼륨" Foreground="{DynamicResource Accent}"/>
    </Grid>
    <TextBlock x:Name="AudioHint" Style="{StaticResource Caption}" Text="기본 출력 장치 · 재생 중인 앱" Margin="0,5,0,0"/>
   </StackPanel>
  </Border>
  <TextBlock x:Name="FooterStatus" Style="{StaticResource Caption}" Margin="2,14,0,0"/>
 </StackPanel>
 </ScrollViewer></Border>
</Window>
