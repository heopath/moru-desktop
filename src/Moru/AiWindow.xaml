<Window Foreground="{DynamicResource Ink}" x:Class="Moru.AiWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="모루 · AI 작업" Width="490" Height="710" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" UseLayoutRounding="True" PreviewKeyDown="OnKeyDown">
 <Window.Resources>
  <Style x:Key="TaskCard" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Padding" Value="14"/><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Row" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Stretch"/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource Soft}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Row" Property="Opacity" Value="0.7"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Border Background="{DynamicResource Canvas}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="22" Padding="22">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
  <Grid Margin="0,0,0,18"><TextBlock Text="AI 작업" FontSize="{DynamicResource TitleSize}" FontWeight="SemiBold" VerticalAlignment="Center"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="AI 연결 설정" AutomationProperties.Name="AI 연결 설정" Click="OnSettings"/><Button Style="{StaticResource IconButton}" Content="&#xE8BB;" ToolTip="대시보드로" AutomationProperties.Name="AI 작업 닫기" Click="OnHide"/></StackPanel>
  </Grid>
  <Border Style="{StaticResource Card}" Background="{DynamicResource Soft}"><StackPanel><Grid><TextBlock Text="Codex" FontWeight="SemiBold"/><TextBlock x:Name="CodexConnection" Style="{StaticResource Caption}" HorizontalAlignment="Right"/></Grid>
   <TextBlock x:Name="CodexState" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,12,0,8"/><TextBlock x:Name="CodexUsage" Style="{StaticResource Caption}"/>
  </StackPanel></Border>
  <Border Style="{StaticResource Card}" Margin="0,14,0,0"><StackPanel><Grid><TextBlock Text="Claude Code" FontWeight="SemiBold"/><TextBlock x:Name="ClaudeConnection" Style="{StaticResource Caption}" HorizontalAlignment="Right"/></Grid>
   <TextBlock x:Name="ClaudeState" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,12,0,8"/><TextBlock x:Name="ClaudeUsage" Style="{StaticResource Caption}"/>
  </StackPanel></Border>
  <TextBlock Text="최근 작업" FontWeight="SemiBold" Margin="0,24,0,12"/>
  <ItemsControl x:Name="RecentTasks"><ItemsControl.ItemTemplate><DataTemplate>
   <Button Style="{StaticResource TaskCard}" Margin="0,0,0,8" IsEnabled="{Binding CanOpen}" AutomationProperties.Name="{Binding AccessibleName}" Click="OnOpenTask">
    <StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" Margin="0,5,0,0"/><TextBlock Text="{Binding OpenHint}" Style="{StaticResource Caption}" Foreground="{DynamicResource Accent}" Margin="0,8,0,0"/></StackPanel>
   </Button>
  </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  <TextBlock x:Name="TaskOpenNotice" Style="{StaticResource Caption}" Visibility="Collapsed" Margin="0,6,0,6" AutomationProperties.LiveSetting="Polite"/>
  <TextBlock x:Name="EmptyTasks" Text="연결한 도구에서 작업을 시작하면 여기에 나타나요." Style="{StaticResource Caption}"/>
  <Expander Header="남은 한도와 상태 안내" Foreground="{DynamicResource Muted}" FontSize="{DynamicResource SmallSize}" Margin="0,20,0,0"><TextBlock Style="{StaticResource Caption}" Margin="0,12,0,0" Text="한도는 마지막으로 받은 정보의 남은 비율이에요. 누적 토큰과 컨텍스트 사용률은 별도 정보이며 청구액이 아니에요. Codex 작업을 누르면 해당 채팅을 열어요. 활동이 5분간 없으면 상태 확인 필요로 표시해요."/></Expander>
 </StackPanel></ScrollViewer></Border>
</Window>
