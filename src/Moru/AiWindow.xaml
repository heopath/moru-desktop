<Window x:Class="Moru.AiWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="모루 · AI 작업" Width="420" Height="700"
        Background="#FCFDFB" ResizeMode="CanMinimize" WindowStartupLocation="CenterOwner">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="24">
      <TextBlock Text="함께 일하는 AI 친구들" FontSize="22" FontWeight="SemiBold" />
      <TextBlock Text="작업은 도구에서, 상태는 바탕화면에서." Foreground="{StaticResource Muted}" Margin="0,8,0,18" />
      <Border Background="{DynamicResource Soft}" Padding="15" CornerRadius="14">
        <StackPanel>
          <CheckBox x:Name="CodexToggle" Content="Codex 연결" FontWeight="SemiBold" Checked="OnCodex" Unchecked="OnCodex" />
          <TextBlock x:Name="CodexConnection" FontSize="10" Margin="0,8,0,4" Foreground="{StaticResource Muted}" />
          <TextBlock x:Name="CodexState" TextWrapping="Wrap" FontWeight="SemiBold" />
          <TextBlock x:Name="CodexUsage" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0" LineHeight="18" />
        </StackPanel>
      </Border>
      <Border Background="#F5EFEA" Padding="15" CornerRadius="14" Margin="0,12,0,0">
        <StackPanel>
          <CheckBox x:Name="ClaudeToggle" Content="Claude Code 연결" FontWeight="SemiBold" Checked="OnClaude" Unchecked="OnClaude"
                    ToolTip="Claude Code 설정에 모루 작업 훅과 비어 있는 상태줄을 추가합니다. 기존 설정은 백업합니다." />
          <TextBlock x:Name="ClaudeConnection" TextWrapping="Wrap" FontSize="10" Margin="0,8,0,4" Foreground="{StaticResource Muted}" />
          <TextBlock x:Name="ClaudeState" TextWrapping="Wrap" FontWeight="SemiBold" />
          <TextBlock x:Name="ClaudeUsage" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0" LineHeight="18" />
        </StackPanel>
      </Border>
      <TextBlock Text="최근 작업" FontWeight="SemiBold" Margin="0,20,0,7" />
      <TextBlock x:Name="RecentTasks" TextWrapping="Wrap" FontSize="11" LineHeight="20" />
      <TextBlock Text="동작 미리보기" FontWeight="SemiBold" Margin="0,18,0,8" />
      <UniformGrid Columns="3">
        <Button Content="대기" Tag="Idle" Click="OnPreview" Margin="0,0,5,0" />
        <Button Content="작업 중" Tag="Working" Click="OnPreview" Margin="0,0,5,0" />
        <Button Content="완료!" Tag="Done" Click="OnPreview" />
      </UniformGrid>
      <TextBlock Text="미리보기는 동작만 보여주며 실제 작업 상태를 바꾸지 않아요." TextWrapping="Wrap" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,8,0,0" />
      <TextBlock Text="Codex는 로컬 기록 기반의 실험적 연결입니다. 도구 버전에 따라 이벤트가 누락될 수 있어요. 5분간 활동이 없으면 상태 확인 필요로 표시합니다. 한도는 마지막 수신값이며 실시간 청구액이 아닙니다. 일반 Claude 웹·채팅 앱은 지원하지 않아요."
                 TextWrapping="Wrap" FontSize="10" Foreground="{StaticResource Muted}" LineHeight="16" Margin="0,18,0,0" />
    </StackPanel>
  </ScrollViewer>
</Window>
