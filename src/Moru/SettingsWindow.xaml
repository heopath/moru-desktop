<Window Foreground="{DynamicResource Ink}" x:Class="Moru.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Moru"
 Title="모루 · 설정" Width="570" Height="730" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="True" UseLayoutRounding="True" PreviewKeyDown="OnKeyDown">
 <Border Background="{DynamicResource Canvas}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="22" Padding="24">
 <DockPanel>
  <Grid DockPanel.Dock="Top" Margin="0,0,0,18" MouseLeftButtonDown="OnDrag">
   <TextBlock Text="설정" FontSize="{DynamicResource TitleSize}" FontWeight="SemiBold" VerticalAlignment="Center"/>
   <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" ToolTip="설정 닫기" AutomationProperties.Name="설정 닫기" Click="OnHide" HorizontalAlignment="Right"/>
  </Grid>
  <Grid DockPanel.Dock="Bottom" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock x:Name="SaveNotice" Text="변경하면 자동 저장돼요." Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,12,0"/>
   <Button Grid.Column="1" Content="모루 종료" Click="OnExit"/>
  </Grid>
  <TabControl x:Name="Tabs">
   <TabItem Header="화면"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,8,12,0">
    <Border Style="{StaticResource Card}"><StackPanel>
     <CheckBox x:Name="DarkToggle" Content="다크 모드" Checked="OnAppearance" Unchecked="OnAppearance"/>
     <TextBlock Text="글자 크기" Margin="0,18,0,8" FontWeight="SemiBold"/>
     <ComboBox x:Name="TextSizePicker" SelectionChanged="OnTextSize" AutomationProperties.Name="글자 크기">
      <ComboBoxItem Content="기본 · 16" Tag="16"/><ComboBoxItem Content="크게 · 18" Tag="18"/><ComboBoxItem Content="더 크게 · 20" Tag="20"/>
     </ComboBox>
     <TextBlock Text="오늘도 내 속도대로, 편안하게." FontSize="{DynamicResource TitleSize}" TextWrapping="Wrap" Margin="0,18,0,0"/>
     <TextBlock Text="대시보드·AI 작업·설정에 함께 적용돼요." Style="{StaticResource Caption}" Margin="0,8,0,0"/>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}" Margin="0,14,0,0"><StackPanel>
     <CheckBox x:Name="HoverToggle" Content="마우스를 올리면 요약 보기" Checked="OnHover" Unchecked="OnHover"/>
     <CheckBox x:Name="TopmostToggle" Content="캐릭터와 패널을 항상 위에" Checked="OnTopmost" Unchecked="OnTopmost" Margin="0,10,0,0"/>
     <TextBlock Text="PC 사용량 갱신" FontWeight="SemiBold" Margin="0,18,0,8"/>
     <ComboBox x:Name="RefreshPicker" SelectionChanged="OnInterval" AutomationProperties.Name="갱신 간격"><ComboBoxItem Content="2초" Tag="2"/><ComboBoxItem Content="5초" Tag="5"/><ComboBoxItem Content="10초" Tag="10"/></ComboBox>
     <TextBlock Text="보이는 창에서만 측정해요. 평소에는 트레이에 머물러요." Style="{StaticResource Caption}" Margin="0,12,0,0"/>
    </StackPanel></Border>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="캐릭터"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,8,12,0">
    <ItemsControl x:Name="SkinList"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     <ItemsControl.ItemTemplate><DataTemplate><RadioButton GroupName="Skins" Tag="{Binding}" Checked="OnSkinSelected" Margin="0,0,8,8" AutomationProperties.Name="{Binding Name}" ToolTip="{Binding Description}" Cursor="Hand">
      <RadioButton.Template><ControlTemplate TargetType="RadioButton"><Border x:Name="SkinCard" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="14" Padding="8,10">
       <StackPanel><local:PetView Skin="{Binding}" Width="84" Height="76"/><TextBlock Text="{Binding Name}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="124" Margin="0,7,0,0"/></StackPanel>
      </Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="SkinCard" Property="Background" Value="{DynamicResource Soft}"/><Setter TargetName="SkinCard" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="SkinCard" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></RadioButton.Template>
     </RadioButton></DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
    <Button Content="+ PNG 친구 추가" Click="OnImportSkin" Margin="0,8,0,0"/>
    <TextBlock Text="투명 배경 PNG · 권장 512×512 · 최대 2048px / 8MB" Style="{StaticResource Caption}" Margin="0,10,0,18"/>
    <CheckBox x:Name="AnimationToggle" Content="캐릭터 애니메이션" Checked="OnAnimation" Unchecked="OnAnimation"/>
    <UniformGrid Columns="3" Margin="0,12,0,0"><Button Content="대기" Tag="Idle" Click="OnPreview" Margin="0,0,6,0"/><Button Content="작업 중" Tag="Working" Click="OnPreview" Margin="0,0,6,0"/><Button Content="완료" Tag="Done" Click="OnPreview"/></UniformGrid>
    <Button Content="캐릭터 위치 초기화" Click="OnReset" Margin="0,20,0,0"/>
    <Button Content="소개 화면 저장" Click="OnExportPreview" Margin="0,8,0,0"/>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="AI 연결"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,8,12,0">
    <Border Style="{StaticResource Card}"><StackPanel><CheckBox x:Name="CodexToggle" Content="Codex" Checked="OnCodex" Unchecked="OnCodex"/><TextBlock x:Name="CodexNotice" Style="{StaticResource Caption}" Margin="0,12,0,0"/></StackPanel></Border>
    <Border Style="{StaticResource Card}" Margin="0,14,0,0"><StackPanel><CheckBox x:Name="ClaudeToggle" Content="Claude Code" Checked="OnClaude" Unchecked="OnClaude"/><TextBlock x:Name="ClaudeNotice" Style="{StaticResource Caption}" Margin="0,12,0,0"/></StackPanel></Border>
    <TextBlock Text="연결 안내" FontWeight="SemiBold" Margin="0,24,0,12"/>
    <TextBlock Style="{StaticResource Caption}" Text="Codex는 PC에 남은 작업 기록을 읽는 실험적 연결이에요. 도구 버전에 따라 일부 상태가 빠질 수 있어요."/>
    <TextBlock Style="{StaticResource Caption}" Margin="0,12,0,0" Text="Claude Code는 Git Bash가 필요해요. 연결할 때 기존 설정을 백업하고 작업 훅을 추가해요. 새 세션부터 적용되며, 일반 Claude 웹 채팅은 지원하지 않아요."/>
    <Button Content="AI 작업 창 열기" Click="OnAi" Margin="0,20,0,0"/>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="알람"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,8,12,0">
    <Border Style="{StaticResource Card}"><StackPanel>
     <TextBlock Text="잠깐 쉬어 가기" FontWeight="SemiBold"/>
     <UniformGrid Columns="3" Margin="0,12,0,16"><Button Content="5분 후" Tag="5" Click="OnQuickAlarm" Margin="0,0,5,0"/><Button Content="25분 후" Tag="25" Click="OnQuickAlarm" Margin="0,0,5,0"/><Button Content="60분 후" Tag="60" Click="OnQuickAlarm"/></UniformGrid>
     <TextBlock Text="원하는 시간에 알림" FontWeight="SemiBold" Margin="0,0,0,10"/>
     <TextBox x:Name="AlarmTitle" MaxLength="40" Text="잠깐 쉬어 가요" AutomationProperties.Name="알람 이름"/>
     <Grid Margin="0,10,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
      <DatePicker x:Name="AlarmDate" CalendarStyle="{StaticResource AppCalendar}" FontSize="{DynamicResource BodySize}" Foreground="{DynamicResource Ink}" Background="{DynamicResource Surface}" AutomationProperties.Name="알람 날짜" VerticalContentAlignment="Center" Margin="0,0,10,0"/>
      <TextBox x:Name="AlarmTime" Grid.Column="1" MaxLength="5" AutomationProperties.Name="알람 시간" ToolTip="24시간 형식 · 14:30"/>
     </Grid>
     <Button Content="알람 추가" Click="OnAddAlarm"/>
     <TextBlock x:Name="AlarmNotice" Style="{StaticResource Caption}" Margin="0,10,0,0"/>
    </StackPanel></Border>
    <CheckBox x:Name="AlarmSoundToggle" Content="알람 소리" Checked="OnAlarmSound" Unchecked="OnAlarmSound" Margin="0,14,0,8"/>
    <TextBlock Text="모루 실행 중에만 알림 · 절전 중에는 깨우지 않아요." Style="{StaticResource Caption}" Margin="0,0,0,16"/>
    <ItemsControl x:Name="AlarmList"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock Text="{Binding When}" Style="{StaticResource Caption}" Margin="0,5,0,0"/></StackPanel>
     <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="알람 삭제" AutomationProperties.Name="알람 삭제" Tag="{Binding Id}" Click="OnDeleteAlarm"/>
    </Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   </StackPanel></ScrollViewer></TabItem>
  </TabControl>
 </DockPanel></Border>
</Window>
