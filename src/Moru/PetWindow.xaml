<Window x:Class="Moru.PetWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Moru"
        Title="모루 · 바탕화면 친구" Width="160" Height="178" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="True" Topmost="True"
        UseLayoutRounding="True" PreviewKeyDown="OnKeyDown">
  <Button x:Name="PetButton" Padding="0" Background="Transparent" ToolTip="클릭하면 내 PC 상태 · 드래그하면 이동 · 우클릭하면 메뉴"
          AutomationProperties.Name="캐릭터 클릭: CPU와 메모리 보기" Click="OnPetClick"
          PreviewMouseLeftButtonDown="OnPointerDown" PreviewMouseMove="OnPointerMove">
    <Button.Template><ControlTemplate TargetType="Button"><ContentPresenter /></ControlTemplate></Button.Template>
    <StackPanel>
      <Border Height="152" Padding="10,18,10,0"><local:PetView x:Name="Character" Width="140" Height="134" /></Border>
      <Border Background="#F5FFFFFF" BorderBrush="#D8E4DC" BorderThickness="1" CornerRadius="10" Padding="9,3" HorizontalAlignment="Center">
        <TextBlock x:Name="NameLabel" Text="모루 · 클릭해 봐요" FontSize="10" Foreground="#42564A" MaxWidth="122" TextTrimming="CharacterEllipsis" />
      </Border>
    </StackPanel>
  </Button>
</Window>
