<Window Foreground="{DynamicResource Ink}" x:Class="Moru.PetWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Moru"
        Title="모루 · 바탕화면 친구" Width="180" Height="206" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" Topmost="True"
        UseLayoutRounding="True" PreviewKeyDown="OnKeyDown">
  <Button x:Name="PetButton" Padding="0" Background="Transparent" ToolTipService.InitialShowDelay="450" ToolTipService.ShowDuration="60000"
          AutomationProperties.Name="캐릭터 클릭: CPU와 메모리 보기" Click="OnPetClick"
          PreviewMouseLeftButtonDown="OnPointerDown" PreviewMouseMove="OnPointerMove">
    <Button.Template><ControlTemplate TargetType="Button"><ContentPresenter /></ControlTemplate></Button.Template>
    <Button.ToolTip><ToolTip x:Name="HoverTip" Placement="Left" Opened="OnHoverOpened" Closed="OnHoverClosed">
      <StackPanel Width="260"><TextBlock x:Name="HoverTime" FontSize="{DynamicResource TitleSize}" FontWeight="SemiBold"/>
        <TextBlock x:Name="HoverDate" Style="{StaticResource Caption}" Margin="0,3,0,12"/>
        <TextBlock x:Name="HoverMetrics" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock x:Name="HoverAi" Style="{StaticResource Caption}" Margin="0,10,0,0"/>
        <TextBlock Text="클릭해서 열기 · 드래그해서 이동" Style="{StaticResource Caption}" Margin="0,12,0,0"/>
      </StackPanel>
    </ToolTip></Button.ToolTip>
    <StackPanel>
      <Border Height="160" Padding="10,18,10,0"><local:PetView x:Name="Character" Width="140" Height="134" /></Border>
      <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" Padding="11,5" HorizontalAlignment="Center">
        <TextBlock x:Name="NameLabel" Text="모루" FontSize="{DynamicResource SmallSize}" MaxWidth="150" TextTrimming="CharacterEllipsis" />
      </Border>
    </StackPanel>
  </Button>
</Window>
